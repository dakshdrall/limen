{
  "name": "@limen/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schema, migrations and typed queries for Limen. Two access paths, one schema: neon-http from the web app, a bounded pool from the runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/schema.d.ts", "default": "./dist/schema.js" },
    "./web": { "types": "./dist/web.d.ts", "default": "./dist/web.js" },
    "./runtime": { "types": "./dist/runtime.d.ts", "default": "./dist/runtime.js" }
  },
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "node scripts/migrate.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5",
    "vitest": "^4"
  }
}
