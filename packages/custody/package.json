{
  "name": "@limen/custody",
  "version": "0.1.0",
  "private": true,
  "description": "The key Limen holds, and what wraps it. At M1: the KeyProvider interface and its env-var implementation. Server-only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
