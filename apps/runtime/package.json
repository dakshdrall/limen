    "test:watch": "vitest"
  },
  "dependencies": {
    "@limen/db": "*",
    "@limen/kv": "*",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4"
  }
}
