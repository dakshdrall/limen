{
  "name": "@limen/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "The agent runtime: queue, worker loop and scheduler. One long-lived Node process, separate from apps/web by decision §7.5.4.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js",
